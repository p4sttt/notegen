---
import type { Locale } from '../../i18n/ui';
import { ui } from '../../i18n/ui';

interface Props {
  locale: Locale;
  baseUrl: string;
}

const { locale, baseUrl } = Astro.props;
const t = ui[locale];
---

<div class="mobile-bottom-bar" id="mobile-bottom-bar">
  <a href={`${baseUrl}?lang=${locale}`} class="mobile-bar-btn" data-lang-link>
    <span class="mobile-bar-icon">🏠</span>
    <span class="mobile-bar-label">{t.home}</span>
  </a>

  <button type="button" class="mobile-bar-btn" data-search-trigger>
    <span class="mobile-bar-icon">🔍</span>
    <span class="mobile-bar-label">{t.search}</span>
  </button>

  <button type="button" class="mobile-bar-btn" id="mobile-toc-trigger">
    <span class="mobile-bar-icon">📑</span>
    <span class="mobile-bar-label">{t.contents}</span>
  </button>

  <button type="button" class="mobile-bar-btn" id="mobile-prefs-trigger">
    <span class="mobile-bar-icon">⚙️</span>
    <span class="mobile-bar-label">{t.menu}</span>
  </button>
</div>

<!-- Mobile TOC Drawer / Bottom Sheet -->
<div class="mobile-toc-sheet" id="mobile-toc-sheet" aria-hidden="true">
  <div class="mobile-toc-backdrop" id="mobile-toc-backdrop"></div>
  <div class="mobile-toc-content">
    <div class="mobile-toc-header">
      <span class="mobile-toc-title">📑 {t.contents}</span>
      <button type="button" class="mobile-toc-close" id="mobile-toc-close">✕</button>
    </div>
    <div class="mobile-toc-body" id="mobile-toc-body"></div>
  </div>
</div>

<script is:inline>
  (() => {
    const tocTrigger = document.getElementById('mobile-toc-trigger');
    const prefsTrigger = document.getElementById('mobile-prefs-trigger');
    const sheet = document.getElementById('mobile-toc-sheet');
    const backdrop = document.getElementById('mobile-toc-backdrop');
    const closeBtn = document.getElementById('mobile-toc-close');
    const tocBody = document.getElementById('mobile-toc-body');

    if (!sheet || !tocBody) return;

    function openToc() {
      // Find TOC in desktop page
      const desktopToc = document.querySelector('.toc-nav');
      if (desktopToc && tocBody) {
        tocBody.innerHTML = desktopToc.outerHTML;
        // Listen for links inside mobile TOC
        tocBody.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeToc);
        });
      } else if (tocBody) {
        tocBody.innerHTML =
          '<p style="padding: 1.5rem; text-align: center; color: var(--text-soft);">Оглавление недоступно</p>';
      }

      sheet.classList.add('is-open');
      sheet.setAttribute('aria-hidden', 'false');
    }

    function closeToc() {
      sheet.classList.remove('is-open');
      sheet.setAttribute('aria-hidden', 'true');
    }

    if (tocTrigger) tocTrigger.addEventListener('click', openToc);
    if (closeBtn) closeBtn.addEventListener('click', closeToc);
    if (backdrop) backdrop.addEventListener('click', closeToc);

    if (prefsTrigger) {
      prefsTrigger.addEventListener('click', () => {
        const prefsDetails = document.querySelector('.prefs-popover');
        if (prefsDetails) {
          prefsDetails.open = !prefsDetails.open;
          if (prefsDetails.open) {
            prefsDetails.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    }
  })();
</script>
