---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteText } from '../config/site';
import { topics as rawTopics, topLevelNotes as rawNotes } from '../data/generated/topics';
import { Topic, Note } from '../entities/domain';
import { defaultLocale, getLocaleFromUrl, ui } from '../i18n/ui';
import EntityCard from '../shared/ui/EntityCard.astro';

const locale = Astro.url ? getLocaleFromUrl(Astro.url) : defaultLocale;
const t = ui[locale];
const copy = siteText[locale];
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const allTopics = rawTopics.map((t) => new Topic(t));
const allTopLevelNotes = rawNotes.map((n) => new Note(n));
const inProgressNotes = [...allTopics.flatMap((topic) => topic.notes), ...allTopLevelNotes].filter(
  (note) => note.isInProgress(),
);
---

<BaseLayout
  title={`${t.drafts} | ${copy.brand}`}
  description={copy.metaDescription}
  titleI18nKey="drafts"
  titleSuffixI18nKey="brand"
  descriptionI18nKey="metaDescription"
>
  <div class="home-panel">
    <header class="hero home-panel-section">
      <div class="hero-kicker">
        <p class="eyebrow" data-i18n="draftsEyebrow">{t.draftsEyebrow}</p>
        <span class="hero-tag">{inProgressNotes.length}</span>
      </div>
      <div class="hero-copy-block">
        <h1 data-i18n="drafts">{t.drafts}</h1>
      </div>
    </header>

    <hr class="section-divider" />

    <section id="drafts" class="section-block home-panel-section">
      {
        inProgressNotes.length === 0 ? (
          <div class="empty-state">
            <p data-i18n="empty">{t.empty}</p>
          </div>
        ) : (
          <div class="entity-grid">
            {inProgressNotes.map((note) => (
              <EntityCard
                title={note.title}
                summary={note.summary}
                href={`${baseUrl}${note.collectionSlug}/?lang=${locale}`}
                badgeLabel={t.inProgress}
                badgeI18nKey="inProgress"
              >
                <Fragment slot="meta">{note.updatedAt || note.sourcePath}</Fragment>
              </EntityCard>
            ))}
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
