---
import { getCollection } from 'astro:content';
import {
  topics as rawTopics,
  topLevelDatabases as rawDatabases,
  topLevelNotes as rawNotes,
} from '../data/generated/topics';
import { isPublishedNote } from '../entities/topic/model';
import { defaultLocale, getLocaleFromUrl } from '../i18n/ui';
import { Topic, Note, Database } from '../entities/domain';
import TopicPage from '../layouts/TopicPage.astro';
import DatabasePage from '../layouts/DatabasePage.astro';
import NotePage from '../layouts/NotePage.astro';

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const topicEntries = await getCollection('topics', ({ data }) => includeDrafts || !data.draft);
  const notes = await getCollection('notes', ({ data }) => isPublishedNote(data));

  const topicPaths = topicEntries
    .map((entry) => {
      const topicSlug = entry.data.slug ?? entry.slug;
      const topic = rawTopics.find((item) => item.slug === topicSlug);
      if (!topic) {
        return null;
      }

      return {
        params: { slug: topicSlug },
        props: { kind: 'topic', topic, entry },
      };
    })
    .filter(Boolean);

  const generatedNotes = [...rawTopics.flatMap((topic) => topic.notes), ...rawNotes];
  const generatedDatabases = [...rawTopics.flatMap((topic) => topic.databases), ...rawDatabases];
  const notePaths = notes.map((note) => {
    const generatedNote = generatedNotes.find((item) => item.sourcePath === note.data.sourcePath);
    return {
      params: { slug: generatedNote?.collectionSlug ?? note.slug },
      props: { kind: 'note', note, generatedNote },
    };
  });
  const databasePaths = generatedDatabases.map((database) => ({
    params: { slug: database.collectionSlug },
    props: { kind: 'database', database },
  }));

  return [...topicPaths, ...notePaths, ...databasePaths];
}

const locale = Astro.url ? getLocaleFromUrl(Astro.url) : defaultLocale;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const props = Astro.props;
const includeDrafts = import.meta.env.DEV;
const visibleTopics = (includeDrafts ? rawTopics : rawTopics.filter((topic) => !topic.draft)).map(
  (t) => new Topic(t),
);

// Instantiate OOP model depending on kind
const topicModel = props.kind === 'topic' ? new Topic(props.topic) : null;
const databaseModel = props.kind === 'database' ? new Database(props.database) : null;
const noteModel = props.kind === 'note' ? new Note(props.generatedNote || props.note.data) : null;
---

{
  props.kind === 'topic' && topicModel && (
    <TopicPage
      topic={topicModel}
      entry={props.entry}
      visibleTopics={visibleTopics}
      includeDrafts={includeDrafts}
      locale={locale}
      baseUrl={baseUrl}
    />
  )
}
{
  props.kind === 'database' && databaseModel && (
    <DatabasePage database={databaseModel} locale={locale} baseUrl={baseUrl} />
  )
}
{
  props.kind === 'note' && noteModel && (
    <NotePage note={noteModel} entry={props.note} locale={locale} baseUrl={baseUrl} />
  )
}
