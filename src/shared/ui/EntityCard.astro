---
import TagBadge from "./TagBadge.astro";

interface Props {
  title: string;
  summary?: string;
  href: string;
  badgeLabel?: string;
  badgeI18nKey?: string;
  tags?: string[];
}

const { title, summary, href, badgeLabel, badgeI18nKey, tags = [] } = Astro.props;
---

<a class="entity-card" href={href} data-lang-link>
  <div class="entity-card-heading">
    <h3>{title}</h3>
    <div class="entity-card-badges">
      {badgeLabel ? <span class="entity-card-badge" data-i18n={badgeI18nKey}>{badgeLabel}</span> : null}
    </div>
  </div>
  {summary ? <p>{summary}</p> : null}
  <div class="entity-card-footer">
    <span><slot name="meta" /></span>
    {tags.map(tag => (
      <TagBadge tag={tag} />
    ))}
  </div>
</a>

<style>
  .entity-card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }
</style>
